# Server Configuration
PORT=3000
NODE_ENV=development

# Application URL (for QR codes)
APP_URL=http://localhost:3000

# ========================================
# EMAIL CONFIGURATION (Choose ONE option)
# ========================================

# OPTION 1: Resend (Recommended for Railway/Production) ✅
# Sign up: https://resend.com/signup
# 100 emails/day free, works great with Railway
RESEND_API_KEY=re_123456789
EMAIL_FROM=noreply@yourdomain.com

# OPTION 2: SMTP (Gmail, SendGrid, etc.) - May not work on Railway
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_FROM=noreply@yourorg.com

# ========================================

# Admin Password (CHANGE THIS!)
ADMIN_PASSWORD=admin123

# Database
DB_PATH=./database.sqlite

# Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads
